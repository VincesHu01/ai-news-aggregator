# Database (Production: PostgreSQL from Supabase)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Secret Key (auto-generated by Render)
# SECRET_KEY=your-secret-key

# Local Ollama (only used when this backend runs on the same Mac)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=dailybrief-qwen:8b

# Production cloud receives cards already generated by local Ollama.
LOCAL_INGEST_ONLY=true
NEXUS_INGEST_TOKEN=replace-with-a-long-random-secret

# Feishu custom bot webhook; keep the real value in Render environment variables.
FEISHU_WEBHOOK_URL=
PUBLIC_APP_URL=https://ai-news-frontend-kappa.vercel.app

# CORS
CORS_ORIGINS=["*"]

# Collection Interval (hours)
COLLECTION_INTERVAL_HOURS=24

# Logging
LOG_LEVEL=INFO
