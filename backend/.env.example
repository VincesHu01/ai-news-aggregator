# Database (Production: PostgreSQL from Supabase)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Secret Key (auto-generated by Render)
# SECRET_KEY=your-secret-key

# LLM Configuration (JSON array)
# LLM_PROVIDERS=[{"name":"Doubao","api_key":"your-api-key","base_url":"https://ark.cn-beijing.volces.com/api/v3","model":"glm-5-2-260617","priority":1}]

# CORS
CORS_ORIGINS=["*"]

# Collection Interval (hours)
COLLECTION_INTERVAL_HOURS=24

# Logging
LOG_LEVEL=INFO
